*.uasset
*.umap

# --- IDE / 생성 파일 ---
.vs/
.idea/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj/
*.xcworkspace/

# --- 다른 VCS ---
.svn/

# --- Node ---
node_modules/
npm-debug.log*
coverage/

# --- 서드파티 바이너리 (헤더/lib) ---
ThirdParty/MySQL/

# --- 플러그인: 에셋/리소스/서드파티 바이너리 제외, Source 와 .uplugin 만 유지 ---
Plugins/*/Content/
Plugins/*/Resources/
Plugins/*/Binaries/
Plugins/*/Intermediate/
Plugins/*/ThirdParty/
Plugins/*/Reports/

# --- 외부 제작 플러그인 전체 제외 (자체 제작분만 공개) ---
